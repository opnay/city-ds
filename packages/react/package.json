  "files": [
    "dist",
    "src/styles/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "dev": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --watch",
    "lint": "eslint src tests vitest.config.ts",
    "pack:check": "publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
